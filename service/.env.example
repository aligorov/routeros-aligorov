# Скопировать в .env (gitignored) и заполнить.

# Каталог репозитория стора (по умолчанию — сам репо, где лежит service/)
# REPO_DIR=/Users/aleksey/Documents/routeros-aligorov

# Базовый URL стора (для иконок в store.yaml)
STORE_BASE_URL=https://aligorov.github.io/routeros-aligorov

# Telegram-бот (создать через @BotFather -> /newbot)
TELEGRAM_BOT_TOKEN=

# ID Telegram-пользователей, кому разрешено добавлять/удалять (через запятую).
# Свой ID узнает @userinfobot. ПУСТО = бот никому не отвечает (защита).
TELEGRAM_ALLOWED_IDS=

# Подтверждение публикации без кнопки (для CLI): 1 = разрешить коммит
# ALLOW_COMMIT=1

# --- M4: публикация без локального клона (GitHub API) ---
# Fine-grained PAT: https://github.com/settings/tokens — только этот репо,
# Metadata:R + Contents:RW. С ним Docker-контейнеру не нужен смонтированный репо.
# GITHUB_TOKEN=github_pat_...
# PUBLISHER=github-api   # local | github-api (авто: github-api если есть токен и нет лок. репо)

# --- M3: HTTP-вход MCP (streamable HTTP, POST /mcp) ---
# MCP_TOKEN=secret-bearer-для-эндпоинта
# PORT=8765
